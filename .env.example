# Modèle des variables d'environnement. Copiez ce fichier en `.env.local`
# pour le développement ; sur o2switch, saisissez-les dans cPanel →
# Setup Node.js App → Environment variables. Ne versionnez jamais les vraies
# valeurs (le .gitignore ignore .env* sauf ce modèle).

# --- Back-office : générez les trois lignes avec `npm run admin:setup` ---
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Alertes e-mail (SMTP) ---
# Créez une boîte dans cPanel → Comptes de messagerie, puis renseignez-la ici.
SMTP_HOST=mail.jamora-technologie.com
SMTP_PORT=465
# « true » pour le port 465 (TLS implicite), « false » pour 587 (STARTTLS).
# Omis : déduit du port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché. Omis : « Jamora Technologie » <SMTP_USER>.
MAIL_FROM=
# Qui reçoit les alertes. Plusieurs adresses : séparez par des virgules.
NOTIFY_TO=

# --- Optionnel ---
# Dossier des données (demandes, réglages). Défaut : ./data
# DATA_DIR=
